{
  "name": "@vertixara/dsh-prompt-manager",
  "version": "0.3.0",
  "description": "DeepSeek Harness 的分层提示词管理器：全局、工作区、会话级提示词档案，内置段落与上下文的禁用/覆盖，子代理作用域，以及完整的 Web 管理界面。",
  "author": "Vertixara <public@vertixara.com> (https://github.com/elfmingh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfmingh/dsh-prompt-manager.git"
  },
  "homepage": "https://github.com/elfmingh/dsh-prompt-manager#readme",
  "bugs": {
    "url": "https://github.com/elfmingh/dsh-prompt-manager/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"test/*.test.mjs\"",
    "check:diff": "node test/check-diff.mjs",
    "check:client": "node test/check-client.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "system-prompt",
    "prompt-template"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
